# APP
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
LOG_LEVEL=info

# Docs & CORS
DOCS_ENABLED=true
CORS_ORIGINS=["*"]

# OBSERVABILITY (Prometheus)
# Порт HTTP-сервера метрик воркера (API отдаёт метрики на своём APP_PORT по /metrics)
METRICS_PORT=8001

# DATABASE
POSTGRES_SCHEMA=postgresql+asyncpg
POSTGRES_USER=pyostr
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=demo_clean_architect_db

# FAIL-FAST STARTUP
STRICT_STARTUP=false

# API AUTH (JSON array of static keys)
PAYMENTS_API_KEYS=["dev-key"]

# RABBITMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_MAX_RETRIES=3

# NGINX (единая точка входа для всех web-сервисов; единственный внешний порт)
NGINX_PORT=8601

# OUTBOX
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_DELAY=1.0
OUTBOX_RETRY_MAX_DELAY=60.0

# WEBHOOK
WEBHOOK_SECRET=webhook-dev-secret
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_BASE_DELAY=1.0
WEBHOOK_TIMEOUT=10.0
WEBHOOK_POLL_INTERVAL=1.0

# PAYMENT GATEWAY (emulator)
GATEWAY_MIN_DELAY=2.0
GATEWAY_MAX_DELAY=5.0
GATEWAY_FAILURE_RATE=0.1
